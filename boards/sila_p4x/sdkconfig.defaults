CONFIG_IDF_TARGET="esp32p4"

# P4X uses v3.x silicon; the connected board is revision v3.2.
# CONFIG_ESP32P4_SELECTS_REV_LESS_V3 is not set
CONFIG_ESP32P4_REV_MIN_301=y
CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ_400=y

# JEDEC EF 70 19 reports 32 MiB, unlike the upstream 16 MiB setting.
CONFIG_ESPTOOLPY_FLASHSIZE_32MB=y
CONFIG_ESPTOOLPY_FLASHMODE_QIO=y
CONFIG_ESPTOOLPY_FLASHFREQ_80M=y
# JEDEC manufacturer 0xEF needs the Winbond driver for addresses above 16 MiB.
CONFIG_SPI_FLASH_SUPPORT_WINBOND_CHIP=y

CONFIG_SPIRAM=y
CONFIG_SPIRAM_MODE_HEX=y
CONFIG_SPIRAM_SPEED_250M=y

# GPIO24/25 remain available for the native USB-Serial/JTAG console.
CONFIG_ESP_CONSOLE_USB_SERIAL_JTAG=y
CONFIG_ESP_CONSOLE_SECONDARY_NONE=y

# Keep the USB/QIO bootloader within the 0x2000..0x8000 boot area.
CONFIG_BOOTLOADER_LOG_LEVEL_WARN=y
