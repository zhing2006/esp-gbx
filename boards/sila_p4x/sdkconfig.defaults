CONFIG_IDF_TARGET="esp32p4"

# P4X uses v3.x silicon; the connected board is revision v3.2.
# CONFIG_ESP32P4_SELECTS_REV_LESS_V3 is not set
CONFIG_ESP32P4_REV_MIN_301=y
CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ_400=y

# JEDEC EF 70 19 reports 32 MiB, unlike the upstream 16 MiB setting.
CONFIG_ESPTOOLPY_FLASHSIZE_32MB=y
CONFIG_ESPTOOLPY_FLASHMODE_QIO=y
CONFIG_ESPTOOLPY_FLASHFREQ_80M=y
# JEDEC manufacturer 0xEF needs the Winbond driver for addresses above 16 MiB.
CONFIG_SPI_FLASH_SUPPORT_WINBOND_CHIP=y

CONFIG_SPIRAM=y
CONFIG_SPIRAM_MODE_HEX=y
CONFIG_SPIRAM_SPEED_250M=y

# GPIO24/25 remain available for the native USB-Serial/JTAG console.
CONFIG_ESP_CONSOLE_USB_SERIAL_JTAG=y
CONFIG_ESP_CONSOLE_SECONDARY_NONE=y

# Keep the USB/QIO bootloader within the 0x2000..0x8000 boot area.
CONFIG_BOOTLOADER_LOG_LEVEL_WARN=y

# The Bluetooth gamepad through the C5, see components/platform/src/esp/bt/
CONFIG_GBX_BT_GAMEPAD=y
# ESP-Hosted on SDMMC slot 1 to the C5, Bluetooth only, on a 1-bit bus: D0
# carries the data and D1 the interrupt, as upstream's reads on D2 and D3
# come back corrupted, see docs/boards/sila_p4x.md. The C5's EN is on GPIO54.
# ESP-Hosted drops the co-processor's start-up event from a chip other than
# the one set here.
# The firmware starts ESP-Hosted itself, and a link failure stops the
# gamepad instead of restarting the console.
CONFIG_ESP_HOSTED_HOST_FEAT_BT=y
CONFIG_ESP_HOSTED_HOST_FEAT_WIFI=n
CONFIG_ESP_HOSTED_AUTO_CALL_INIT_BEFORE_APP_MAIN=n
CONFIG_ESP_HOSTED_HOST_TRANSPORT_RESTART_ON_FAILURE=n
CONFIG_ESP_HOSTED_DFLT_TASK_FROM_SPIRAM=y
CONFIG_SLAVE_IDF_TARGET_ESP32C5=y
CONFIG_ESP_HOSTED_SDIO_SLOT_1=y
CONFIG_ESP_HOSTED_HOST_SDIO_BUS_WIDTH_1=y
CONFIG_ESP_HOSTED_HOST_SDIO_PIN_CMD=19
CONFIG_ESP_HOSTED_HOST_SDIO_PIN_CLK=18
CONFIG_ESP_HOSTED_HOST_SDIO_PIN_D0=14
CONFIG_ESP_HOSTED_HOST_SDIO_PIN_D1=15
CONFIG_ESP_HOSTED_HOST_RESET_GPIO=54
# NimBLE for pairing, as a central over the C5's controller, its memory in
# PSRAM and its bonds in RAM: the firmware saves what it needs itself.
CONFIG_BT_ENABLED=y
CONFIG_BT_CONTROLLER_DISABLED=y
CONFIG_BT_NIMBLE_ENABLED=y
CONFIG_BT_NIMBLE_TRANSPORT_UART=n
CONFIG_BT_NIMBLE_MEM_ALLOC_MODE_EXTERNAL=y
CONFIG_BT_NIMBLE_50_FEATURE_SUPPORT=n
CONFIG_BT_NIMBLE_ROLE_CENTRAL=y
CONFIG_BT_NIMBLE_ROLE_OBSERVER=y
CONFIG_BT_NIMBLE_ROLE_PERIPHERAL=n
CONFIG_BT_NIMBLE_ROLE_BROADCASTER=n
CONFIG_BT_NIMBLE_SECURITY_ENABLE=y
CONFIG_BT_NIMBLE_SM_LEGACY=y
CONFIG_BT_NIMBLE_SM_SC=y
# Secure Connections' ECDH through mbedtls, as on the JC1060P470, where
# TinyCrypt on the P4 v1.0's ECC accelerator gives a wrong DHKey. TinyCrypt
# on this board's v3.2 is untested.
CONFIG_BT_NIMBLE_CRYPTO_STACK_MBEDTLS=y
# mbedtls, which only pairing uses, allocates in PSRAM: the state it keeps
# after the first pairing would otherwise hold internal RAM that games and
# the SD card's DMA need.
CONFIG_MBEDTLS_EXTERNAL_MEM_ALLOC=y
CONFIG_BT_NIMBLE_NVS_PERSIST=n
CONFIG_BT_NIMBLE_MAX_CONNECTIONS=1
CONFIG_BT_NIMBLE_LOG_LEVEL_WARNING=y
# The LP core's program: code, data, buffers and stack in 16 KB of LP SRAM
CONFIG_ULP_COPROC_ENABLED=y
CONFIG_ULP_COPROC_TYPE_LP_CORE=y
CONFIG_ULP_COPROC_RESERVE_MEM=16384
