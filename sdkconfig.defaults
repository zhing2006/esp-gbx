# Settings shared by all boards and build types. IDF loads SoC policy from
# sdkconfig.defaults.<target> next. Build type settings are in
# sdkconfig.defaults.debug and sdkconfig.defaults.release, profiling builds
# add sdkconfig.defaults.profile, board settings are in
# boards/<board>/sdkconfig.defaults; later files override earlier ones.

# C++ without exceptions or RTTI, see docs/architecture.md
# CONFIG_COMPILER_CXX_EXCEPTIONS is not set
# CONFIG_COMPILER_CXX_RTTI is not set

# JIT writes and executes an internal code pool. Disable IDF's RX/RW split
# on every board/build; valid-address protection still follows the SoC port.
# CONFIG_ESP_SYSTEM_MEMPROT is not set

# Copy code and read-only data from flash to PSRAM at startup and run them
# from there: cache misses refill from the hex PSRAM bus instead of quad flash.
# Boards without PSRAM drop this option.
CONFIG_SPIRAM_XIP_FROM_PSRAM=y
# EXT_RAM_BSS_ATTR places cold static buffers in PSRAM: the JIT code pool
# needs a large contiguous block of internal RAM. Boards without PSRAM drop
# this option and keep the buffers internal.
CONFIG_SPIRAM_ALLOW_BSS_SEG_EXTERNAL_MEMORY=y
# No internal pool set aside at startup for DMA and internal-only
# allocations: IDF cuts it from the largest internal block, the one the JIT
# code pools need, and the heap turns to it only once the rest of internal
# RAM is full (components/esp_psram/system_layer/esp_psram.c). Boards
# without PSRAM drop this option.
CONFIG_SPIRAM_MALLOC_RESERVE_INTERNAL=0

# IDF code that leaves internal RAM. Code in IRAM is for running while the
# cache is off, but with code and read-only data in PSRAM, flash reads keep
# the cache on. The firmware erases or writes flash only to save a Bluetooth
# gamepad's pairing, from HOME, see components/platform/src/esp/bt/.
# No IRAM interrupt handler allocates, takes a C library lock or uses a ring
# buffer: the UART and USB Serial/JTAG handlers are not IRAM. The I2C handler
# serves the touch panel, the codec and the clock, a few transfers a frame.
# Moving the heap also drops the GP-SPI master handler, which no board uses.
CONFIG_HEAP_PLACE_FUNCTION_INTO_FLASH=y
CONFIG_RINGBUF_PLACE_ISR_FUNCTIONS_INTO_FLASH=y
# CONFIG_LIBC_LOCKS_PLACE_IN_IRAM is not set
# CONFIG_I2C_MASTER_ISR_HANDLER_IN_IRAM is not set

# Flash layout: two app slots, the UI asset pack and a core dump partition
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"
CONFIG_ESP_COREDUMP_ENABLE_TO_FLASH=y

# 1 ms ticks: driver delays such as 5 ms panel resets are not cut to zero ticks,
# and frame and audio pacing get finer sleeps
CONFIG_FREERTOS_HZ=1000
# Per-task run time in esp_timer microseconds, for the cores' IDLE in the
# telemetry; 64 bits do not wrap after 71 minutes
CONFIG_FREERTOS_GENERATE_RUN_TIME_STATS=y
CONFIG_FREERTOS_RUN_TIME_STATS_USING_ESP_TIMER=y
CONFIG_FREERTOS_RUN_TIME_COUNTER_TYPE_U64=y

# Test ROM paths contain long names and spaces. Use UTF-8 at the VFS boundary.
CONFIG_FATFS_LFN_HEAP=y
CONFIG_FATFS_MAX_LFN=255
CONFIG_FATFS_API_ENCODING_UTF_8=y

# UART bootloader/app console and test transport share one baud rate.
# Custom UART mode makes the baud configurable; pins keep their SoC defaults.
# idf.py flashing also defaults to 460800. USB boards override the console below.
CONFIG_ESP_CONSOLE_UART_CUSTOM=y
CONFIG_ESP_CONSOLE_UART_BAUDRATE=460800

# The app's input loop runs in the main task
CONFIG_ESP_MAIN_TASK_STACK_SIZE=8192

# LVGL draws the UI into a full-screen RGB565 shadow, see platform/esp/display.cpp
CONFIG_LV_COLOR_FORMAT_RGB565=y
CONFIG_LV_OS_NONE=y
# LVGL's heap prefers PSRAM, see platform/esp/lvgl_memory.cpp
CONFIG_LV_USE_CUSTOM_MALLOC=y
CONFIG_LV_DEF_REFR_PERIOD=16
CONFIG_LV_DRAW_BUF_ALIGN=64
CONFIG_LV_DRAW_BUF_STRIDE_ALIGN=1
# CONFIG_LV_BUILD_EXAMPLES is not set
# CONFIG_LV_BUILD_DEMOS is not set

# The UI uses only objects, images and canvases with RGB565 and RGB565A8
# pixels. The default theme links every enabled widget, so unused widgets are
# off. LVGL renders its own layers in ARGB8888 and A8.
CONFIG_LV_DRAW_SW_SUPPORT_RGB565A8=y
# CONFIG_LV_DRAW_SW_SUPPORT_RGB565_SWAPPED is not set
# CONFIG_LV_DRAW_SW_SUPPORT_RGB888 is not set
# CONFIG_LV_DRAW_SW_SUPPORT_XRGB8888 is not set
# CONFIG_LV_DRAW_SW_SUPPORT_ARGB8888_PREMULTIPLIED is not set
# CONFIG_LV_DRAW_SW_SUPPORT_L8 is not set
# CONFIG_LV_DRAW_SW_SUPPORT_AL88 is not set
# CONFIG_LV_DRAW_SW_SUPPORT_I1 is not set
# CONFIG_LV_USE_THEME_SIMPLE is not set
# CONFIG_LV_USE_THEME_MONO is not set
# CONFIG_LV_USE_FLEX is not set
# CONFIG_LV_USE_GRID is not set
# CONFIG_LV_USE_OBSERVER is not set
# CONFIG_LV_USE_ANIMIMG is not set
# CONFIG_LV_USE_ARC is not set
# CONFIG_LV_USE_ARCLABEL is not set
# CONFIG_LV_USE_BAR is not set
# CONFIG_LV_USE_BUTTON is not set
# CONFIG_LV_USE_BUTTONMATRIX is not set
# CONFIG_LV_USE_CALENDAR is not set
# CONFIG_LV_USE_CHART is not set
# CONFIG_LV_USE_CHECKBOX is not set
# CONFIG_LV_USE_DROPDOWN is not set
# CONFIG_LV_USE_IMAGEBUTTON is not set
# CONFIG_LV_USE_KEYBOARD is not set
# CONFIG_LV_USE_LABEL is not set
# CONFIG_LV_USE_LED is not set
# CONFIG_LV_USE_LINE is not set
# CONFIG_LV_USE_LIST is not set
# CONFIG_LV_USE_MENU is not set
# CONFIG_LV_USE_MSGBOX is not set
# CONFIG_LV_USE_ROLLER is not set
# CONFIG_LV_USE_SCALE is not set
# CONFIG_LV_USE_SLIDER is not set
# CONFIG_LV_USE_SPAN is not set
# CONFIG_LV_USE_SPINBOX is not set
# CONFIG_LV_USE_SPINNER is not set
# CONFIG_LV_USE_SWITCH is not set
# CONFIG_LV_USE_TABLE is not set
# CONFIG_LV_USE_TABVIEW is not set
# CONFIG_LV_USE_TEXTAREA is not set
# CONFIG_LV_USE_TILEVIEW is not set
# CONFIG_LV_USE_WIN is not set
