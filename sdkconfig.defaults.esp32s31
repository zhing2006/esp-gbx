CONFIG_SPIRAM_SPEED_250M=y

# ESP32-S31 has PPA and DMA2D. Prepare the shared display policy before
# board bring-up; this target has not been validated on hardware.
CONFIG_GBX_DISPLAY_ACCEL=y
CONFIG_LV_USE_PPA=y
CONFIG_LV_USE_PPA_IMG=y
CONFIG_GBX_LVGL_PPA_MIN_PIXELS=4096
# The RGB panel's DMA underran when LVGL drew while the PPA drew a game
# frame, see components/platform/Kconfig.
CONFIG_GBX_DISPLAY_LOCK_GAME_DRAW=y

# Internal RAM cannot hold the GBA's execution core and run-time data next
# to the JIT's code pool, so this chip builds the GB alone, whose execution
# core takes internal RAM instead (docs/plans/gba/task-7-1.md). See
# components/core/Kconfig.
CONFIG_GBX_SYSTEMS_GB_ONLY=y
